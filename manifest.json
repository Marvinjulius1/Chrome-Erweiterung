{
  "manifest_version": 3,
  "name": "Zenith",
  "short_name": "Zenith",
  "version": "0.4.0",
  "description": "A calm, minimal new tab: a beautiful photo for every time of day, the time, a greeting and a thought for the day.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
